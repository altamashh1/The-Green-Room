PORT=4000

# Required. Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: defaults to gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: comma-separated models to fall back to when the primary is
# rate-limited or out of quota (429). Defaults shown below.
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite,gemini-2.0-flash

# Database (libSQL / Turso). Leave BOTH unset locally to use a plain file at
# backend/greenroom.db. In production set these to your Turso database:
#   turso db show <name> --url          -> DATABASE_URL
#   turso db tokens create <name>       -> DATABASE_AUTH_TOKEN
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token

# Required in production. Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_string

# Local admin account, created automatically on first run.
ADMIN_EMAIL=admin@greenroom.local
ADMIN_PASSWORD=change_this_before_deploying

# Optional: set to your deployed frontend origin to lock down CORS in production
# ALLOWED_ORIGIN=https://your-frontend.example.com

# Optional: set to "production" on your host to enforce secret checks
# NODE_ENV=production
